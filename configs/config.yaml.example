# ── API ────────────────────────────────────────────────────────────────────
api:
  host: 127.0.0.1
  port: 8080
  max_queue_depth: 128
  request_timeout_seconds: 180.0
  max_request_tokens: 32768
  api_key: null                 # set to require Authorization: Bearer <key>
  rate_limit_per_minute: 0      # 0 disables in-memory per-client limiting
  responses_store_max_entries: 1000  # in-memory previous_response_id replay history

# ── Primary model ──────────────────────────────────────────────────────────
model:
  name: Qwen3.5-9B
  path: /ABSOLUTE/PATH/TO/Qwen3.5-9B-MLX
  context_length: 16384
  enable_thinking: false      # default; callers can override per-request

# ── Speculative decoding (draft model) ─────────────────────────────────────
speculative:
  enabled: false
  draft_name: Qwen3.5-0.8B
  draft_path: /ABSOLUTE/PATH/TO/Qwen3.5-0.8B-MLX
  max_draft_tokens: 0
  min_acceptance_rate: 0.45
  min_speedup_ratio: 1.05
  auto_disable_on_regression: true

# ── Engine ─────────────────────────────────────────────────────────────────
engine:
  runtime_kernel: manual       # manual today; batch_generator is an experimental boundary
  paged_cache_enabled: false   # opt-in; requires prefix cache off and decode batch 1
  paged_cache_direct_attention_enabled: false  # experimental; requires paged cache and Qwen3.5
  max_active_requests: 16
  max_decode_batch: 4
  prefill_token_budget: 1024
  idle_prefill_token_limit: 4096
  pressure_prefill_token_budget: 512
  decode_active_prefill_token_budget: 512
  snapshot_budget_bytes: 8589934592   # 8 GB
  snapshot_min_prefix_tokens: 64
  snapshot_max_entries: 256
  snapshot_reservation_trace_max_events: 64
  prefix_cache_enabled: true
  prefix_cache_persist_path: null  # e.g. ./data/prefix-cache.pkl
  prefix_cache_load_on_warmup: true
  prefix_cache_save_on_shutdown: true
  warm_prompts_path: null          # JSON list of chat message arrays
  warm_prompts_max_tokens: 1
  warm_prompts_concurrency: 1
  stream_interval_tokens: 1
  memory_headroom_ratio: 0.10

# ── Autotune ───────────────────────────────────────────────────────────────
autotune:
  enabled: false
  startup_warmup: false
  profile_path: ./configs/autotune_profile.json
  benchmark_prompt_tokens: [4096, 8192, 16384]
  concurrency_levels: [1, 2, 4]

# ── Telemetry & logging ────────────────────────────────────────────────────
telemetry:
  json_logs: true
  metrics_namespace: aster

logging:
  level: INFO

# ── Embeddings ─────────────────────────────────────────────────────────────
embeddings:
  enabled: true
  backend: mlx
  model: mlx-community/Qwen3-Embedding-0.6B-4bit-DWQ
  model_path: /ABSOLUTE/PATH/TO/Qwen3-Embedding-0.6B-4bit-DWQ
  dimensions: 1024
  max_length: 512

# ── Audio ──────────────────────────────────────────────────────────────────
audio:
  max_audio_upload_mb: 25
  max_tts_input_chars: 4096
  asr:
    enabled: true
    backend: mlx
    model: Qwen3-ASR-0.6B
    model_path: /ABSOLUTE/PATH/TO/qwen3-asr-0.6b
  tts:
    enabled: true
    backend: mlx
    model: Qwen3-TTS-0.6B-Base
    model_path: /ABSOLUTE/PATH/TO/qwen3-tts-0.6b-base
    custom_voice_model: null
    custom_voice_path: null
    default_voice: af_heart
    cache_enabled: true
    cache_max_entries: 128
